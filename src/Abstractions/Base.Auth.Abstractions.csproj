<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Basilisque.Base.Auth.Abstractions</PackageId>
    <TargetFrameworks>$(BAS_Auth_TargetFramework);net48</TargetFrameworks>
    <IsAotCompatible Condition="'$(TargetFramework)' == '$(BAS_Auth_TargetFramework)'">true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <Reference Include="System.ComponentModel.DataAnnotations" />
  </ItemGroup>
</Project>
