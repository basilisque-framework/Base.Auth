<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>$(BAS_Auth_TargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" />
    <ProjectReference Include="../../src/DataAccess.EntityFramework.SqlServer/Base.Auth.DataAccess.EntityFramework.SqlServer.csproj" />
    <ProjectReference Include="../../src/DataAccess.EntityFramework.SQLite/Base.Auth.DataAccess.EntityFramework.SQLite.csproj" />
    <ProjectReference Include="../../src/DataAccess.EntityFramework.PostgreSQL/Base.Auth.DataAccess.EntityFramework.PostgreSQL.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
